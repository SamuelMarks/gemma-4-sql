+def test_chat_keras_imports_fail(monkeypatch: pytest.MonkeyPatch) -> None:
+    import sys
+    import importlib
+    import gemma_4_sql.backends.keras.chat as mdl
+    
+    monkeypatch.setitem(sys.modules, "keras", None)
+    importlib.reload(mdl)
+    monkeypatch.undo()
